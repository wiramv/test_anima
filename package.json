{
  "name": "car-assembly-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "A local-renderable Remotion + React Three Fiber animation about assembling a car.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts CarAssembly out/car-assembly.mp4",
    "still": "remotion still src/index.ts CarAssembly out/car-assembly-poster.png --frame=540",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.2.0",
    "@remotion/cli": "4.0.544",
    "@remotion/three": "4.0.544",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.181.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.544",
    "three": "0.181.1",
    "typescript": "5.9.3"
  }
}
