{
  "name": "car-assembly-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "A local-renderable Remotion + React Three Fiber animation about assembling a car.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts LegoCar out/lego-car.mp4 --concurrency=2 --codec=h264 --crf=16",
    "render:scene2": "remotion render src/index.ts LegoCar out/scene02-chassis.mp4 --frames=1950-3749 --concurrency=2 --scale=2 --codec=h264 --crf=16",
    "still": "remotion still src/index.ts LegoCar out/lego-car-poster.png --frame=17700",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "4.0.544",
    "@remotion/three": "4.0.544",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.181.0",
    "postprocessing": "^6.39.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.544",
    "three": "0.181.1",
    "typescript": "5.9.3"
  }
}
